; https://github.com/uiriansan/SilentSDDM

[SddmGreeterTheme]
Name=Silent
Type=sddm-theme
Description=A fork of Silent SDDM theme with a more modern design and a focus on simplicity.
License=GPL-3.0-or-later
Version=1.0.0
Theme-Id=natan-custom
Theme-API=2.0
MainScript=Main.qml
Screenshot=docs/previews/default.png
TranslationsDirectory=translations
QtVersion=6

